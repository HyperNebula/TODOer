{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TODOer+",
  "version": "0.9.5",
  "identifier": "com.david.todoer-plus",
  "build": {
    "beforeDevCommand": "npm run dev:plus",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:plus",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TODOer+",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
